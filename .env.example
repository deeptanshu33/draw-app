# ─────────────────────────────────────────────
# draw-app — Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env at the project root,
# and to each service directory that needs it:
#   packages/db/.env
#   apps/http-backend/.env
#   apps/ws-backend/.env
# ─────────────────────────────────────────────

# PostgreSQL (used by Prisma and both backends)
DATABASE_URL="postgresql://drawapp:drawapp@localhost:5432/drawapp"

# JWT secret for authentication (change in production)
JWT_SECRET="your-jwt-secret-here"
